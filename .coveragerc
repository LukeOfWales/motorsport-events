# Coverage configuration.
# ical.py is a documented, unused iCal adapter template.
# main.py is FastAPI glue best covered by integration tests, not unit tests.
[run]
omit =
    app/adapters/ical.py
    app/main.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
